---
import '../styles/base.css';
import DemoNotice from '../components/layout/DemoNotice.astro';
import type { SiteConfig } from '../utils/content';

interface Props {
  locale: string;
  siteConfig: SiteConfig;
  ui: Record<string, any>;
  navItems: Array<{ id: string; href: string }>;
}

const { locale, siteConfig, ui, navItems } = Astro.props;
const defaultLocale = siteConfig.i18n.defaultLocale;
const siteTitle = siteConfig.site.title[locale] || siteConfig.site.title[defaultLocale];
const siteTagline = siteConfig.site.tagline[locale] || siteConfig.site.tagline[defaultLocale];
const colors = siteConfig.theme?.colors || {};
// Deployment base path ("https://user.github.io/repo" -> "/repo/", custom domains -> "/")
const rawBase = import.meta.env.BASE_URL;
const baseUrl = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const showDemoNotice = siteConfig.site?.demoContent ?? (siteConfig.security?.demoMode === true);

// Custom brand colors from site.yaml apply to the LIGHT appearance only, so a
// curated warm dark palette and the WCAG-AAA high-contrast palette can never be
// broken by user-provided light-theme hues.
const customLightVars = Object.entries({
  'bg-canvas': colors.background,
  'bg-surface': colors.surface,
  'bg-elevated': colors.surfaceElevated,
  'color-primary': colors.primary,
  'color-primary-dark': colors.primaryDark,
  'color-secondary': colors.secondary,
  'color-accent': colors.accent,
  'color-text': colors.text,
  'color-text-muted': colors.textMuted,
})
  .filter(([, value]) => Boolean(value))
  .map(([token, value]) => `--${token}: ${value};`)
  .join('');

const themeLabels = {
  light: ui.theme?.toLight || 'Switch to light theme',
  dark: ui.theme?.toDark || 'Switch to dark theme',
  contrast: ui.theme?.toContrast || 'Switch to high-contrast theme',
};
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle} — {siteTagline}</title>
    <meta name="description" content={siteTagline} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
    <script is:inline>
      // Theme bootstrap — must run before first paint to avoid a flash of the wrong palette.
      // Priority: saved visitor choice > OS contrast preference > OS color scheme > light.
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem('oc-theme');
        } catch (err) {
          /* Storage unavailable (strict privacy mode) — fall through to OS preferences. */
        }
        var theme;
        if (saved === 'light' || saved === 'dark' || saved === 'contrast') {
          theme = saved;
        } else if (window.matchMedia('(prefers-contrast: more)').matches) {
          theme = 'contrast';
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          theme = 'dark';
        } else {
          theme = 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    {customLightVars && (
      <style is:inline set:html={`html[data-theme='light'] { ${customLightVars} }`} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{ui.a11y?.skipLink || 'Skip to main content'}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href={`${baseUrl}${locale}/`} class="brand-link">
          <span class="brand-mark" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#D96B43" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5" fill="#E6B84C" />
              <line x1="12" y1="1" x2="12" y2="3" />
              <line x1="12" y1="21" x2="12" y2="23" />
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
              <line x1="1" y1="12" x2="3" y2="12" />
              <line x1="21" y1="12" x2="23" y2="12" />
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
            </svg>
          </span>
          <span>
            <span class="brand-title">{siteTitle}</span>
            <span class="brand-subtitle">{siteConfig.site.location.city}</span>
          </span>
        </a>

        <nav class="main-nav" id="site-nav" aria-label="Primary Navigation">
          {
            navItems.map((item) => (
              <a href={item.href} class="nav-link">
                {ui.nav?.[item.id] || item.id}
              </a>
            ))
          }
        </nav>

        <div class="lang-switcher" role="navigation" aria-label="Language switcher">
          {
            siteConfig.i18n.locales.map((loc) => (
              <a
                href={`${baseUrl}${loc.code}/`}
                class={`lang-pill ${loc.code === locale ? 'active' : ''}`}
                hreflang={loc.code}
              >
                {loc.flag} {loc.code.toUpperCase()}
              </a>
            ))
          }
        </div>

        <div class="header-actions">
          <button
            type="button"
            id="theme-toggle"
            class="theme-toggle"
            data-next="dark"
            data-label-light={themeLabels.light}
            data-label-dark={themeLabels.dark}
            data-label-contrast={themeLabels.contrast}
            aria-label={themeLabels.dark}
          >
            <svg class="icon-sun" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="5" />
              <line x1="12" y1="1" x2="12" y2="3" />
              <line x1="12" y1="21" x2="12" y2="23" />
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
              <line x1="1" y1="12" x2="3" y2="12" />
              <line x1="21" y1="12" x2="23" y2="12" />
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
            </svg>
            <svg class="icon-moon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
            </svg>
            <svg class="icon-contrast" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor" stroke="none" />
            </svg>
          </button>

          <button
            type="button"
            id="nav-toggle"
            class="nav-toggle"
            aria-expanded="false"
            aria-controls="site-nav"
            aria-label={ui.nav?.toggle || 'Menu'}
          >
            <svg class="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
              <line x1="4" y1="7" x2="20" y2="7" />
              <line x1="4" y1="12" x2="20" y2="12" />
              <line x1="4" y1="17" x2="20" y2="17" />
            </svg>
            <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
              <line x1="6" y1="6" x2="18" y2="18" />
              <line x1="18" y1="6" x2="6" y2="18" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <strong style="font-size: 1.08rem;">{siteTitle}</strong>
          <p style="margin-top: 0.35rem;">{ui.footer?.privacyNote}</p>
        </div>
        <div style="text-align: right;">
          <p>
            © {new Date().getFullYear()} {siteTitle}. {ui.footer?.rights}
          </p>
          <p style="margin-top: 0.3rem;">
            <a href={`${baseUrl}admin/`}>{ui.footer?.adminLink}</a>
          </p>
        </div>
      </div>
    </footer>

    {showDemoNotice && (
      <DemoNotice
        title={ui.demoNotice?.title}
        body={ui.demoNotice?.body}
        accept={ui.demoNotice?.accept}
      />
    )}

    <script is:inline>
      // Appearance toggle — cycles light -> dark -> contrast, persists the choice,
      // and mirrors the NEXT theme's icon/label onto the button.
      (function () {
        var order = ['light', 'dark', 'contrast'];
        var root = document.documentElement;
        var button = document.getElementById('theme-toggle');

        function nextOf(theme) {
          return order[(order.indexOf(theme) + 1) % order.length];
        }

        function reflect(theme) {
          if (!button) return;
          var next = nextOf(theme);
          var label = button.getAttribute('data-label-' + next) || 'Switch theme';
          button.setAttribute('data-next', next);
          button.setAttribute('aria-label', label);
          button.setAttribute('title', label);
        }

        reflect(root.getAttribute('data-theme') || 'light');

        if (button) {
          button.addEventListener('click', function () {
            var next = nextOf(root.getAttribute('data-theme') || 'light');
            root.setAttribute('data-theme', next);
            reflect(next);
            try {
              localStorage.setItem('oc-theme', next);
            } catch (err) {
              /* Storage unavailable — the choice simply won't persist. */
            }
          });
        }
      })();
    </script>

    <script is:inline>
      (function () {
        var header = document.querySelector('.site-header');
        var toggle = document.getElementById('nav-toggle');
        if (!header || !toggle) return;

        function setNav(open) {
          header.classList.toggle('nav-open', open);
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        }

        toggle.addEventListener('click', function () {
          setNav(!header.classList.contains('nav-open'));
        });

        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape' && header.classList.contains('nav-open')) {
            setNav(false);
            toggle.focus();
          }
        });

        // Anchor links close the menu so the target section stays visible.
        header.querySelectorAll('.main-nav a').forEach(function (link) {
          link.addEventListener('click', function () {
            setNav(false);
          });
        });
      })();
    </script>
  </body>
</html>
