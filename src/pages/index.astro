---
import { getSiteConfig } from '../utils/content';

const siteConfig = getSiteConfig();
const defaultLocale = siteConfig.i18n.defaultLocale || 'hu';
const siteTitle = siteConfig.site.title[defaultLocale] || 'OpenCreche';
// Deployment base path from astro.config.mjs ("https://user.github.io/repo" -> "/repo/", custom domains -> "/")
const rawBase = import.meta.env.BASE_URL;
const baseUrl = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <!-- No-JS fallback only: with JavaScript enabled, the inline script below redirects
         (to the visitor's preferred language) before this meta refresh can fire. -->
    <noscript>
      <meta http-equiv="refresh" content={`0;url=${baseUrl}${defaultLocale}/`} />
    </noscript>
    <script is:inline define:vars={{ baseUrl, defaultLocale, locales: siteConfig.i18n.locales.map((l) => l.code) }}>
      (function () {
        var navLang = (navigator.language || '').slice(0, 2).toLowerCase();
        var target = locales.indexOf(navLang) !== -1 ? navLang : defaultLocale;
        window.location.replace(baseUrl + target + '/');
      })();
    </script>
  </head>
  <body style="font-family: sans-serif; background: #FAF6F0; color: #2C2523; display: grid; place-items: center; min-height: 100vh;">
    <p>
      Redirecting to <a href={`${baseUrl}${defaultLocale}/`}>{siteTitle} ({defaultLocale.toUpperCase()})</a>...
    </p>
  </body>
</html>
